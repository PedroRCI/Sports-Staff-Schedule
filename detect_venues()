def detect_venues(df):
    venues = set()

    flat = df.values.flatten()

    for val in flat:
        try:
            val_str = str(val).lower()

            for v in KNOWN_VENUES:
                if v.lower() in val_str:
                    venues.add(v.title())

        except:
            continue  # safely skip bad values

    return list(venues)
